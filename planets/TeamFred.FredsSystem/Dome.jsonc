{
    //////////// NOTES ////////////
    // In some places within this document, "planet" & "station" will be used interchangeable. These all refer to the same components.
    // COIN will refer to specifically the rotating cyclinder
    //   with points of interest
    // DOUBLE DOME will refer to specifically the outer shell of the station
    // (Currently since there is a single object for the combined coin &
    //   double dome, there is not a distinction within this file)
    //////////// END OF NOTES ////////////
    "$schema": "https://raw.githubusercontent.com/Outer-Wilds-New-Horizons/new-horizons/main/NewHorizons/Schemas/body_schema.json",
    // Name of the planet in game
    "name": "DoubleDome",
    // System the planet belongs to (our Mod Jam system)
    "starSystem": "TeamFred.FredsSystem",
    // This is a performance optimization,
    //   since we aren't expecting others to be trying to create this planet
    "checkForExisting": false,
    // Basic descriptors of the planet
    "Base": {
        "surfaceSize": 300,
        "surfaceGravity": 0,
        // Xen told us to turn this off, since we will be doing
        //   "Planet within a Planet". For Reference:
        //   https://discord.com/channels/929708786027999262/1055610226394537994/1534027298867515523
        "hasFluidDetector": false,
        "showMinimap": false
    },
    // Atmosphere settings
    "Atmosphere": {
        "hasOxygen": true,
        "size": 600
    },
    // Definiting "Orbit" - Currently set as a static object to represent a
    //   station. Might switch this to the Sun spot in the future
    //   (& not have a sun)
    "Orbit": {
        "primaryBody": "Pistachio Pulsar",
        "isStatic": true,
        // these values are for a 45* diagonal offset of 6000 units
        "staticPosition": {
            "x": 4242.64069,
            "y": 4242.64069,
            "z": 0
        }
    },
    // If we want the planet to glow.
    //   Currently just playing around with this - Crystal
    "AmbientLights": [
        {
            "outerRadius": 200,
            "tint": {
                "r": 240,
                "g": 246,
                "b": 255,
                "a": 255
            },
            "intensity": 0.2
        }
    ],
    // Defines the player & ship as spawning relative to the planet
    "Spawn": {
        "playerSpawnPoints": [
            {
                // Default for the system
                "isDefault": true,
                // Suit is equipped
                "startWithSuit": true,
                // Sitting in cockpit
                "startInShip": true
            }
        ],
        "shipSpawnPoints": [
            {
                // Default for the system
                "isDefault": true,
                // below settings are relative to the planet
                "isRelativeToParent": true,
                // This offset puts you directly in front of the
                //   (current) opening in the double dome
                "offset": {
                    "x": 0,
                    "y": 0,
                    "z": -1500
                }
            }
        ]
    },
    // "Props" or objects placed at the location marked by NH in prior config
    //   This includes the station itself
    "Props": {
        "details": [
            // Just the Dome
            {
                "assetBundle": "planets/Assets/Bundles/Coinworld Bundle Test 6/coinworld",
                "path": "Assets/Prefabs/Dome.prefab",
                "position": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                },
                "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                },
                "keepLoaded": true
            }
        ]
    },
    // Will only want one of these between the Double Dome & the Coin, otherwise 2 different autopilot points will be set up
    "MapMarker": {
        "enabled": true
    }
}
