    // Will only want one of these between the Double Dome & the Coin, otherwise 2 different autopilot points will be set up
    "MapMarker": {
        "enabled": false,
        "maxDisplayDistanceOverride": 1
    },
    "ReferenceFrame": {
        "enabled": false,
        "hideInMap": true
    },
    "ShipLog": {
        "mapMode": {
            "remove": true
        }
    }
