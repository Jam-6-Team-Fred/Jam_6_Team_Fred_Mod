    "Atmosphere": {
        "size": 230,
        "fogTint": {
            "r": 135,
            "g": 206,
            "b": 250,
            "a": 255
        },
        "fogSize": 230,
        "fogDensity": 0.2,
        "hasRain": false
    },
    // Basic descriptors of the planet
    "Base": {
        "surfaceSize": 300,
        "surfaceGravity": 0,
        "gravityAlignmentRadiusOverride": 0,
        // Xen told us to turn this off, since we will be doing
        //   "Planet within a Planet". For Reference:
        //   https://discord.com/channels/929708786027999262/1055610226394537994/1534027298867515523
        "hasFluidDetector": false,
        "showMinimap": false
    },
    // Definiting "Orbit" - Currently set as a static object to represent a
    //   station. Might switch this to the Sun spot in the future
    //   (& not have a sun)
    "Orbit": {
        "primaryBody": "GE Centerpoint",
        // units away from sun for orbit
        "semiMajorAxis": 55000,
        // 0 = circle, 1 = elipse
        "eccentricity": 0.75,
        // orients upright compared to solar system
        "inclination": 90,
        // Alined with path of Giant's Deep initially
        "longitudeOfAscendingNode": 85,
        // Angles the ellipse to point "down"
        //   (short side is above the plane of planets)
        "argumentOfPeriapsis": 25,
        "trueAnomaly": 65,
        // Disc rotate 180 over the course of the cycle
        "siderealPeriod": 44,
        "showOrbitLine": false
    },
    // "Props" or objects placed at the location marked by NH in prior config
    //   This includes the station itself
    "Props": {
        "details": [
